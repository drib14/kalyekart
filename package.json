{
	"name": "backend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start:server": "node backend/server.js",
		"start:worker": "node backend/workers/email-worker.js",
		"start": "concurrently \"npm:start:server\" \"npm:start:worker\"",
