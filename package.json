		"cors": "^2.8.5",
		"date-fns": "^3.6.0",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"google-auth-library": "^10.3.1",
		"ioredis": "^5.8.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.18.3",
		"multer": "^2.0.2",
		"node-fetch": "^3.3.2",
		"sib-api-v3-sdk": "^8.5.0",
